{
  "name": "ai.privos.mcp-app-demo",
  "version": "2.3.0",
  "type": "module",
  "private": false,
  "description": "Reference PrivOS MCP app demonstrating HR workflows, scoped workspace APIs, AI and sandbox controls, and license-aware features.",
  "title": "PrivOS Demo MCP App",
  "icon": "/public/icon.svg",
  "homepage": "https://privos.ai",
  "author": {
    "name": "PrivOS AI",
    "email": "dev@privos.ai",
    "url": "https://privos.ai"
  },
  "license": {
    "enforcement": "app",
    "tiers": [
      {
        "id": "free",
        "features": [],
        "limits": {
          "records": 50
        }
      },
      {
        "id": "pro",
        "features": [
          "bulk-export"
        ],
        "limits": {
          "records": 5000
        }
      }
    ]
  },
  "dockerfilePath": "Dockerfile",
  "keywords": [
    "hr",
    "management",
    "mcp",
    "demo",
    "privos",
    "relay",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PrivOS-AI/privos-mcp-app-demo"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "vite build && tsx scripts/generate-manifest.ts && npm run manifest:lint",
    "dev": "PRIVOS_RUNTIME_MODE=development PRIVOS_ALLOW_LEGACY_RELAY_PAIRING=1 PRIVOS_TRANSPORT=relay PRIVOS_DEV_UI=1 tsx src/server.ts",
    "start": "tsx src/server.ts",
    "start:relay": "PRIVOS_RUNTIME_MODE=development PRIVOS_ALLOW_LEGACY_RELAY_PAIRING=1 PRIVOS_TRANSPORT=relay tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "manifest:lint": "privos-app-lint privos-app.json",
    "preflight": "tsx scripts/preflight.ts",
    "package": "bash scripts/package-source.sh",
    "docker:build": "bash scripts/build-marketplace-image.sh privos-mcp-app-demo:local",
    "docker:run": "docker run --rm --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 100 --tmpfs /tmp -e PORT=3000 privos-mcp-app-demo:local"
  },
  "dependencies": {
    "@privos_ai/app-server": "file:vendor/privos_ai-app-server-0.4.1.tgz",
    "dotenv": "^17.3.1",
    "tsx": "^4.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@privos_ai/app-react": "^0.3.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
