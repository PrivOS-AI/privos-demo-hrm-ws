# Local development compatibility only. `npm run dev` sets the two required
# opt-in flags. Pairing may populate these ignored values; never use them in a
# managed production installation.
# PRIVOS_RUNTIME_MODE=development
# PRIVOS_ALLOW_LEGACY_RELAY_PAIRING=1
# PRIVOS_URL=http://localhost:3000
# CLIENT_ID=
# CLIENT_SECRET=

# Vite iframe development
# DEV_TUNNEL=localhost
# VITE_PORT=5179
# PUBLIC_URL=

# Managed production transport. The platform supplies only non-secret identity
# bindings and mounts the per-installation socket; do not set OAuth secrets.
# PRIVOS_RUNTIME_MODE=production
# PRIVOS_TRANSPORT=direct
# PORT=3000
# PRIVOS_HUB_ORIGIN=https://workspace.example.com
# PRIVOS_APP_ID=ai.privos.mcp-app-demo
# PRIVOS_INSTALLATION_ID=
# PRIVOS_WORKLOAD_SOCKET=/run/privos/identity.sock

# Platform-injected license/workspace metadata (never a long-lived OAuth secret).
# PRIVOS_APP_LICENSE=
# PRIVOS_WORKSPACE_ID=
